# Injected by `shopify app dev` locally — leave them commented out here:
# Remix's Vite plugin loads .env *over* process.env, so empty values would
# wipe the ones the CLI provides ("Detected an empty appUrl configuration").
# In production (Coolify) set them as real environment variables.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
SCOPES=read_orders,read_products

# Postgres connection string (local dev: a Postgres container/instance; in
# Coolify: the internal URL of the Postgres resource you attach).
DATABASE_URL="postgresql://user:password@host:5432/product_sales_counter"

# Secret used to authorize calls to POST /api/reconcile, which re-syncs the
# last 30 days of orders for every installed shop. Meant to be called by an
# external scheduler (cron, Coolify scheduled task, ...), never by Shopify
# or a browser — without this, anyone could trigger a resync on demand.
# Generate one with (PowerShell): -join ((1..64) | ForEach-Object { "{0:x}" -f (Get-Random -Maximum 16) })
# or (bash): openssl rand -hex 32
RECONCILE_SECRET=

NODE_ENV=development
