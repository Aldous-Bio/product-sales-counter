# Filled in automatically by `shopify app dev` / `shopify app deploy`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders

# Prisma datasource. SQLite is fine for local dev; use Postgres/MySQL in
# production so multiple app instances share one database.
# e.g. postgresql://user:password@host:5432/product_sales_counter
DATABASE_URL="file:dev.sqlite"

# Shared secret used to authorize calls to the internal reconciliation
# endpoint (/api/reconcile) from an external scheduler (cron, Cloud
# Scheduler, GitHub Actions, etc). Generate with `openssl rand -hex 32`.
RECONCILE_SECRET=
